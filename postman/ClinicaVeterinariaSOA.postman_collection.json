{
  "info": {
    "_postman_id": "b6f2a2b0-1e3a-4f2a-9b2a-veterinaria-soa",
    "name": "Clinica Veterinaria SOA",
    "description": "Coleccion para probar los 3 microservicios (Autenticacion, Citas, Inventario) a traves del API Gateway (puerto 8000). Ejecuta primero 'Login' dentro de la carpeta Autenticacion: guarda el token automaticamente y el resto de requests lo usan solos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    if (pm.environment.name) { pm.environment.set('token', jsonData.token); }",
                  "    console.log('Token guardado:', jsonData.token);",
                  "}",
                  "pm.test('Login responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"recepcion1\",\n  \"password\": \"Vet12345\",\n  \"canal\": \"RECEPCION\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Usuarios de prueba (misma password Vet12345 para todos): recepcion1 (RECEPCIONISTA), vet.gomez (VETERINARIO), jperez (PROPIETARIO), caja1 (INVENTARIO_CAJA)."
          }
        },
        {
          "name": "Login con cuenta ya bloqueada (jperez) -> 423",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jperez\",\n  \"password\": \"Vet12345\",\n  \"canal\": \"PROPIETARIO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "La cuenta jperez ya viene BLOQUEADA desde el seed (3 intentos fallidos precargados), por eso responde 423 Locked aunque la contrasena sea correcta."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
